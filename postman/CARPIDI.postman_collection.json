{
  "info": {"_postman_id":"carpidi-mvp-v1","name":"CARPIDI API v1","schema":"https://schema.getpostman.com/json/collection/v2.1.0/collection.json"},
  "variable": [{"key":"baseUrl","value":"http://localhost:8080/api/v1"}],
  "item": [
    {"name":"Auth","item":[
      {"name":"Register client (201)","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\n  \"name\": \"Diana CARPIDI\",\n  \"email\": \"{{clientEmail}}\",\n  \"password\": \"{{clientPassword}}\"\n}"},"url":"{{baseUrl}}/auth/register"},"event":[{"listen":"test","script":{"exec":["pm.test('Client is created', () => pm.response.to.have.status(201));"]}}]},
      {"name":"Reject invalid registration (400)","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\n  \"name\": \"\",\n  \"email\": \"not-an-email\",\n  \"password\": \"short\"\n}"},"url":"{{baseUrl}}/auth/register"},"event":[{"listen":"test","script":{"exec":["pm.test('Validation error is controlled', () => pm.response.to.have.status(400));"]}}]},
      {"name":"Login (200)","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\n  \"email\": \"{{clientEmail}}\",\n  \"password\": \"{{clientPassword}}\"\n}"},"url":"{{baseUrl}}/auth/login"},"event":[{"listen":"test","script":{"exec":["const body = pm.response.json();","pm.test('Tokens are returned', () => { pm.response.to.have.status(200); pm.expect(body.accessToken).to.be.a('string'); });","pm.environment.set('accessToken', body.accessToken);","pm.environment.set('refreshToken', body.refreshToken);"]}}]}
    ]},
    {"name":"Profile","item":[{"name":"Get profile (200)","request":{"method":"GET","header":[{"key":"Authorization","value":"Bearer {{accessToken}}"}],"url":"{{baseUrl}}/me"},"event":[{"listen":"test","script":{"exec":["pm.test('Profile is returned', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().email).to.be.a('string'); });"]}}]}]},
    {"name":"Catalog","item":[
      {"name":"List categories (200)","request":{"method":"GET","url":"{{baseUrl}}/categories"},"event":[{"listen":"test","script":{"exec":["pm.test('Categories are available', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().length).to.be.above(0); });"]}}]},
      {"name":"List products (200)","request":{"method":"GET","url":"{{baseUrl}}/products?page=0&pageSize=20"},"event":[{"listen":"test","script":{"exec":["pm.test('Catalog is available', () => pm.response.to.have.status(200));"]}}]},
      {"name":"Product not found (404)","request":{"method":"GET","url":"{{baseUrl}}/products/00000000-0000-0000-0000-000000000000"},"event":[{"listen":"test","script":{"exec":["pm.test('Missing product is controlled', () => pm.response.to.have.status(404));"]}}]}
    ]},
    {"name":"Platform","item":[{"name":"Health (200)","request":{"method":"GET","url":"{{baseUrl}}/health"},"event":[{"listen":"test","script":{"exec":["pm.test('API is healthy', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().status).to.eql('UP'); });"]}}]}]},
    {"name":"Orders and recommendations","item":[
      {"name":"Create order (201)","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"},{"key":"Authorization","value":"Bearer {{accessToken}}"}],"body":{"mode":"raw","raw":"{\n  \"items\": [{\"variantId\": \"{{variantId}}\", \"quantity\": 1}],\n  \"paymentMethod\": \"MANUAL_TEST\",\n  \"shippingAddress\": {\"line1\": \"Calle 1 # 2-3\", \"city\": \"Bogota\", \"country\": \"CO\"}\n}"},"url":"{{baseUrl}}/orders"},"event":[{"listen":"test","script":{"exec":["pm.test('Order is created', () => pm.response.to.have.status(201));"]}}]},
      {"name":"List orders (200)","request":{"method":"GET","header":[{"key":"Authorization","value":"Bearer {{accessToken}}"}],"url":"{{baseUrl}}/orders"},"event":[{"listen":"test","script":{"exec":["pm.test('Orders are returned', () => pm.response.to.have.status(200));"]}}]},
      {"name":"Save style questionnaire (201)","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"},{"key":"Authorization","value":"Bearer {{accessToken}}"}],"body":{"mode":"raw","raw":"{\n  \"bodyType\": \"Reloj de arena\",\n  \"skinTone\": \"Medio\",\n  \"heightRange\": \"Media\",\n  \"stylePreferences\": [\"casual\", \"elegante\"],\n  \"consent\": true\n}"},"url":"{{baseUrl}}/questionnaire"},"event":[{"listen":"test","script":{"exec":["pm.test('Questionnaire is saved', () => pm.response.to.have.status(201));"]}}]},
      {"name":"Get recommendations (200)","request":{"method":"GET","header":[{"key":"Authorization","value":"Bearer {{accessToken}}"}],"url":"{{baseUrl}}/recommendations"},"event":[{"listen":"test","script":{"exec":["pm.test('Recommendations are returned', () => pm.response.to.have.status(200));"]}}]},
      {"name":"Order without token (401)","request":{"method":"GET","url":"{{baseUrl}}/orders"},"event":[{"listen":"test","script":{"exec":["pm.test('Protected endpoint rejects anonymous', () => pm.response.to.have.status(401));"]}}]}
    ]}
  ]
}
