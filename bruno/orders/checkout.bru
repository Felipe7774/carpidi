meta { name: Checkout; type: http; seq: 5 }
post { url: {{baseUrl}}/orders; body: json }
headers { Authorization: Bearer {{accessToken}}; Content-Type: application/json }
body:json {
  {
    "items": [
      {
        "variantId": "{{variantId}}",
        "quantity": 1
      }
    ],
    "shippingAddress": {
      "line1": "Calle 1 # 2-3",
      "city": "Bogota",
      "country": "Colombia"
    },
    "paymentMethod": "MANUAL_TEST"
  }
}
