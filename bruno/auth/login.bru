meta {
  name: Login
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/auth/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {"email":"{{clientEmail}}","password":"{{clientPassword}}"}
}

tests {
  test("Login returns tokens", function() {
    expect(res.status).to.equal(200);
    expect(res.body).to.have.all.keys("accessToken", "refreshToken", "expiresIn");
    expect(res.body.accessToken).to.be.a("string");
    bru.setVar("accessToken", res.body.accessToken);
    bru.setVar("refreshToken", res.body.refreshToken);
  });
}
