meta { name: Login; type: http; seq: 2 }
post { url: {{baseUrl}}/auth/login; body: json }
headers { Content-Type: application/json }
body:json {
  {"email":"{{clientEmail}}","password":"{{clientPassword}}"}
}
tests { test("Login returns tokens", function() { expect(res.status).to.equal(200); expect(res.body.accessToken).to.be.a("string"); bru.setEnvVar("accessToken", res.body.accessToken); bru.setEnvVar("refreshToken", res.body.refreshToken); }); }
