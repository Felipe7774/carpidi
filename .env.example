# Perfil activo de Spring Boot
SPRING_PROFILES_ACTIVE=supabase

# Copia las cadenas desde Supabase Dashboard > Connect. Nunca subas el archivo .env.
SUPABASE_DB_JDBC_URL=jdbc:postgresql://db.<project-ref>.supabase.co:5432/postgres?sslmode=require
SUPABASE_MIGRATION_JDBC_URL=jdbc:postgresql://db.<project-ref>.supabase.co:5432/postgres?sslmode=require
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=replace-with-the-database-password

# Mantener bajo en el plan gratuito.
DB_POOL_SIZE=3

# Mínimo 32 caracteres; en producción debe venir de un gestor de secretos.
APP_JWT_SECRET=replace-with-a-long-random-development-secret
APP_ALLOWED_ORIGINS=http://localhost:5173
