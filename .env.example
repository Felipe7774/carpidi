# Copia este archivo como .env y asigna valores locales. Nunca subas .env.
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/carpidi
SPRING_DATASOURCE_USERNAME=set-locally
SPRING_DATASOURCE_PASSWORD=set-locally

# Usa un valor aleatorio de 32 bytes o más; en GCP se suministra desde Secret Manager.
APP_JWT_SECRET=set-a-long-random-value-locally
APP_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DB_POOL_SIZE=5

# Activación opcional para crear el primer ADMIN sin guardar credenciales en Git.
APP_BOOTSTRAP_ADMIN_ENABLED=false
APP_BOOTSTRAP_ADMIN_NAME=Administrador CARPIDI
APP_BOOTSTRAP_ADMIN_EMAIL=set-locally
APP_BOOTSTRAP_ADMIN_PASSWORD=set-locally
